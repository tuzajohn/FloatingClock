<Window x:Class="FloatingClock.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FloatingClock.UI"
        mc:Ignorable="d" 
        Title="Floating Clock &amp; Todo" 
        Height="360" Width="300"
        MaxWidth="300" MaxHeight="500"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <!-- Modern, borderless action button style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <!-- Light gray by default -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Use a border to create a subtle circular background on hover -->
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="14" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state: turns light white-gray with bright white text -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- Pressed state: scales down/dims slightly -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                                <Setter Property="Foreground" Value="OrangeRed"/>
                                <!-- Matches your accent color -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <!-- Outer rounded container for the floating widget look -->
    <Border Background="#DD1E1E1E" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Title bar alignment (Icon on the left, buttons on the right) -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Outmost Left: Application Branding Icon -->
                <Image Grid.Column="0" 
                       Source="pack://application:,,,/Assets/app.ico" 
                       Width="18" 
                       Height="18" 
                       VerticalAlignment="Center" 
                       Margin="4,0,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Left Side Label (Optional title context text next to your icon) -->
                <TextBlock Grid.Column="1" 
                           Text="Floating Clock" 
                           Foreground="#FFAAAAAA" 
                           FontSize="11" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center" 
                           Margin="8,0,0,0"/>

                <!-- Right Side: Action buttons stack cluster -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕" 
                            ToolTip="Add New Todo" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Click="AddTodo_Click"/>

                    <Button Content="🧹" 
                            ToolTip="Clear All" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Click="ClearTodos_Click"/>

                    <Button Content="⚙️" 
                            ToolTip="Organize Todos" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Click="OrganizeTodos_Click"/>
                </StackPanel>
            </Grid>

            <!-- ROW 1: Visual Separator line -->
            <Border Grid.Row="1" Background="Red" Height="1.5" Margin="0,0,0,8"/>

            <!-- ROW 2: Main Content (Clock + Todo List) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <!-- 🌟 Ensures this grid area takes up all remaining room -->
                </Grid.RowDefinitions>

                <!-- Clock Display -->
                <TextBlock x:Name="txtClock" Grid.Row="0" Text="12:00:00 PM" 
                           Foreground="OrangeRed" FontSize="22" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8"/>

                <!-- Daily Todo List Container Box -->
                <Border Grid.Row="1" BorderBrush="Red" BorderThickness="1" CornerRadius="6" Padding="4" Background="#11FFFFFF" Margin="0,4,0,0">
                    <!-- 🛠️ ScrollViewer goes HERE, wrapping the ListBox to capture multiple items cleanly -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="lstTodos" Background="Transparent" 
                                 BorderBrush="Transparent" Foreground="White"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Stretch">
                            <!-- Items add sequentially here via your code-behind loop -->
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>