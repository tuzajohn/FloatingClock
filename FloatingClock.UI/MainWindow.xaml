<Window x:Class="FloatingClock.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FloatingClock.UI"
        mc:Ignorable="d" 
        Title="Floating Clock &amp; Todo" Height="320" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Outer rounded container for the floating widget look -->
    <Border Background="#DD1E1E1E" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Action buttons (Clear all, Add new todo, Organize) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                <Button Content="➕" ToolTip="Add New Todo" Margin="2" Padding="6,2" Click="AddTodo_Click"/>
                <Button Content="🧹" ToolTip="Clear All" Margin="2" Padding="6,2" Click="ClearTodos_Click"/>
                <Button Content="⚙️" ToolTip="Organize Todos" Margin="2" Padding="6,2" Click="OrganizeTodos_Click"/>
            </StackPanel>

            <!-- ROW 1: Visual Separator line -->
            <Border Grid.Row="1" Background="Aqua" Height="1.5" Margin="0,0,0,8"/>

            <!-- ROW 2: Main Content (Clock + Todo List) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Clock Display -->
                <TextBlock x:Name="txtClock" Grid.Row="0" Text="12:00:00 PM" 
                           Foreground="Cyan" FontSize="22" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8"/>

                <!-- Daily Todo List -->
                <Border Grid.Row="1" BorderBrush="AliceBlue" BorderThickness="1" CornerRadius="6" Padding="4" Background="#11FFFFFF">
                    <ListBox x:Name="lstTodos" Background="Transparent" 
                             BorderBrush="Transparent" Foreground="White"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch">
                        
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>